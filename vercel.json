{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": ["fra1"],
  "buildCommand": "python scripts/prepare_public.py",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{back_end/tests/**,back_end/.venv/**,**/__pycache__/**,docs/**,src/**,scripts/**,assets/**,pages/**,*.md,readme,**/*.db,**/*.log,**/.env,**/.env.*}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    }
  ]
}
