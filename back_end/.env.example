# Development: set ENVIRONMENT to development. Production must use HTTPS URLs.
ENVIRONMENT=development
FRONTEND_BASE_URL=http://127.0.0.1:5500

# Initial administrator: must be an existing account email.
ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Email (Brevo SMTP relay).
#
# Copy this file to back_end/.env -- it is read automatically at startup.
# Never commit real values.
#
# Until SMTP_HOST and SMTP_FROM_EMAIL are BOTH set, no email is sent at all:
# each message is printed to the terminal instead, and GET /health reports
# "mail_configured": false. Check /health first if mail is not arriving.
#
# Three things that commonly go wrong:
#
#   1. SMTP_PASSWORD must be the SMTP KEY (Brevo dashboard -> SMTP & API -> SMTP
#      tab). It is NOT an API key and NOT your Brevo account password. The wrong
#      value fails with "535 5.7.8 Authentication failed".
#
#   2. SMTP_USERNAME is the SMTP LOGIN. It may be a generated address such as
#      abc123@smtp-brevo.com and is often NOT the email you signed up with.
#
#   3. SMTP_FROM_EMAIL must be a sender verified in Brevo, or an address on a
#      domain authenticated with SPF/DKIM/DMARC records. Brevo rejects an
#      unverified sender even when the login and key are both correct.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-login@smtp-brevo.com
SMTP_PASSWORD=replace-with-smtp-key
SMTP_FROM_EMAIL=hello@yourdomain.example

# Admin notifications: one email per membership application, contact message,
# newsletter subscription, and new account registration. Each carries the
# submitter's name and email but NOT their message text -- that stays in the
# admin dashboard. Leave this blank and the notifications go nowhere, with only
# an "EMAIL NOT SENT: no recipient address" banner on the server to say so.
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.example

# Payment safety switch. Keep false until the organisation Paystack account,
# production domain, webhook, and live-payment test are complete.
PAYMENTS_ENABLED=false
PAYSTACK_SECRET_KEY=sk_test_replace-with-test-key
