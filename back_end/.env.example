# Development: set ENVIRONMENT to development. Production must use HTTPS URLs.
ENVIRONMENT=development
FRONTEND_BASE_URL=http://127.0.0.1:5500

# Initial administrator: must be an existing account email.
ADMIN_EMAIL=admin@example.com

# SMTP / Brevo. Never commit the real SMTP key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-login@smtp-brevo.com
SMTP_PASSWORD=replace-with-smtp-key
SMTP_FROM_EMAIL=hello@yourdomain.example
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.example

# Payment safety switch. Keep false until the organisation Paystack account,
# production domain, webhook, and live-payment test are complete.
PAYMENTS_ENABLED=false
PAYSTACK_SECRET_KEY=sk_test_replace-with-test-key
